# Copia questo file in .env.local per lo sviluppo e imposta le stesse
# variabili su Vercel (Settings -> Environment Variables) per la produzione.
# Nessuna di queste va mai scritta nel codice di src/.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chiave-service-role-solo-lato-server

# Password della pagina /#/admin (rimozione appunti e annunci, lettura S.O.S.).
# Usa almeno 12 caratteri e non condividerla.
ADMIN_PASSWORD=
